YARN_TOP = [" .-~~-. ", " .~-~-. ", " .~~-~. ", " .-~-~. "]
YARN_MID = ["(\\\\\\\\\\\\)", "(|\\|\\|\\)", "(||||||)", "(/|/|/|)", "(//////)", "(-/-/-/)"]
YARN_BOT = [" `-~~-' ", " `~-~-' ", " `~~-~' ", " `-~-~' "]

MIRROR = str.maketrans("()/\\<>[]{}", ")(\\/><][}{")


def mirror(spr):
    return [l[::-1].translate(MIRROR) for l in spr]


C_FUR = "\x1b[38;5;214m"
C_STRIPE = "\x1b[38;5;166m"
C_EYE = "\x1b[1;38;5;82m"
C_NOSE = "\x1b[38;5;211m"
C_WHISK = "\x1b[38;5;230m"
C_YARN = "\x1b[38;5;197m"
C_YARN2 = "\x1b[38;5;161m"
C_THREAD = "\x1b[38;5;132m"
C_FLOOR = "\x1b[38;5;239m"
C_HEART = "\x1b[1;38;5;204m"
C_TEXT = "\x1b[1;38;5;229m"
C_HINT = "\x1b[38;5;242m"
RESET = "\x1b[0m"


def cat_color(ch):
    if ch == "o":
        return C_EYE
    if ch in "^v\"":
        return C_NOSE
    if ch in "'=":
        return C_STRIPE
    if ch == "~":
        return C_STRIPE
    return C_FUR


class Canvas:
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.ch = [[" "] * w for _ in range(h)]
        self.co = [[""] * w for _ in range(h)]

    def put(self, x, y, c, color):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.w and 0 <= y < self.h:
            self.ch[y][x] = c
            self.co[y][x] = color

    def text(self, x, y, s, color):
        for i, c in enumerate(s):
            self.put(x + i, y, c, color)

    def blit(self, spr, x, y, colorfn):
        x, y = int(round(x)), int(round(y))
        for j, line in enumerate(spr):
            stripped = line.strip()
            if not stripped:
                continue
            a = len(line) - len(line.lstrip())
            b = len(line.rstrip())
            for i in range(a, b):
                c = line[i]
                self.put(x + i, y + j, c, colorfn(c) if c != " " else "")

    def render(self):
        out = []
        for y in range(self.h):
            cur = None
            row = []
            for x in range(self.w):
                col = self.co[y][x]
                if col != cur:
                    row.append(RESET + col if col else RESET)
                    cur = col
                row.append(self.ch[y][x])
            row.append(RESET)
            out.append("".join(row))
        return "\x1b[H" + "\r\n".join(out)


def ease(t):
    t = max(0.0, min(1.0, t))
    return t * t * (3 - 2 * t)


def ease_out(t):
    t = max(0.0, min(1.0, t))
    return 1 - (1 - t) ** 3


PHASES = [("watch", 2.2), ("crouch", 1.1), ("pounce", 0.45), ("roll", 1.6),
          ("bat", 3.4), ("kick", 0.9), ("turn", 0.7)]
CYCLE = sum(d for _, d in PHASES)


class Scene:
    def __init__(self, w, h):
        self.resize(w, h)
        self.blinks = set()
        self.hearts = []
        self.last_heart = 0

    def resize(self, w, h):
        self.w, self.h = w, h
        self.floor = min(h - 3, h // 2 + 7)
        span = max(4, min(22, (w - 60) // 2))
        self.span = span
        self.pounce_d = max(2, span * 6 // 22)
        self.roll_d = span - self.pounce_d
        self.home = w // 2 - span // 2

    def state(self, t):
        cyc = int(t // CYCLE)
        lt = t - cyc * CYCLE
        d = 1 if cyc % 2 == 0 else -1
        start = self.home if d == 1 else self.home + self.span
        acc = 0.0
        for name, dur in PHASES:
            if lt < acc + dur:
                return cyc, d, start, name, (lt - acc) / dur, lt - acc
            acc += dur
        return cyc, d, start, "turn", 1.0, 0.0

    def draw(self, t):
        cv = Canvas(self.w, self.h)
        fl = self.floor
        for x in range(self.w):
            cv.put(x, fl, "▔" if x % 7 else "▔", C_FLOOR)
        cyc, d, c0, ph, p, el = self.state(t)
        hw_sit = len(SIT_A[0]) // 2
        ball_watch = c0 + d * (hw_sit + 6)
        cx = c0
        cy = 0
        pose = SIT_A
        ball_x = ball_watch
        ball_y = 0
        ball_spin = 0.0
        words = None
        heart = False
        thread_from = ball_watch

        roll_end = c0 + d * (self.pounce_d + self.roll_d)
        bat_dur = dict(PHASES)["bat"]

        def bat_x(e):
            return roll_end + d * (-2.5 + 8 * math.sin(e * 1.7))

        ball_bat_x = bat_x(0)

        if ph == "watch":
            pose = SIT_B if int(el / 0.35) % 2 else SIT_A
            if p > 0.55 and int(el * 10) % 13 == 0:
                pose = [l.replace("o   o", "-   -") for l in pose]
            ball_x = ball_watch + math.sin(el * 2.5) * 0.4
        elif ph == "crouch":
            pose = CROUCH_B if int(el / 0.14) % 2 else CROUCH_A
            cx = c0 - d * 1
        elif ph == "pounce":
            pose = POUNCE
            cx = c0 + d * self.pounce_d * ease(p)
            cy = -math.sin(p * math.pi) * 3
            if p > 0.25:
                words = "mrrp!"
            ball_x = ball_watch + d * 3 * ease_out(max(0, (p - 0.7) / 0.3))
        elif ph == "roll":
            seq = [SIDE, BACK_A, BACKVIEW, CROUCH_A, SIDE, BACK_A, BACKVIEW, CROUCH_A, SIDE, BACK_A]
            pose = seq[min(len(seq) - 1, int(p * len(seq)))]
            cx = c0 + d * (self.pounce_d + self.roll_d * ease(p))
            b_start = ball_watch + d * 3
            b_far = roll_end + d * (hw_sit + 10)
            if p < 0.6:
                ball_x = b_start + (b_far - b_start) * ease_out(p / 0.6)
            else:
                ball_x = b_far + (ball_bat_x - b_far) * ease((p - 0.6) / 0.4)
                q = ease((p - 0.6) / 0.4)
                ball_y = -5 * q - math.sin(q * math.pi) * 3
        elif ph == "bat":
            cx = roll_end
            k = el * 2.6
            frac = k - math.floor(k)
            ball_y = -5 - abs(math.sin(k * math.pi)) * 4
            ball_x = bat_x(el)
            hit = frac < 0.18 or frac > 0.82
            pose = [BACK_A, BACK_B, BACK_C][int(k) % 3] if hit else BACK_A
            if hit:
                words = "*bap*"
            heart = True
        elif ph == "kick":
            cx = roll_end
            pose = BACK_C if p < 0.3 else BACK_A
            land = roll_end - d * (hw_sit + 6)
            sx = bat_x(bat_dur)
            ball_x = sx + (land - sx) * ease(p)
            ball_y = -5 * (1 - p) - math.sin(p * math.pi) * 6
            if p < 0.4:
                words = "MEOW!"
        elif ph == "turn":
            cx = roll_end
            land = roll_end - d * (hw_sit + 6)
            ball_x = land
            seq = [BACK_A, BACKVIEW, SIDE, SIT_A]
            pose = seq[min(len(seq) - 1, int(p * len(seq)))]
            if pose is SIT_A:
                d_draw = -d
            else:
                d_draw = d
            self._draw_thread(cv, thread_from, ball_x, ball_y, fl, d)
            self._draw_cat(cv, pose, cx, cy, d_draw, fl)
            self._draw_ball(cv, ball_x, ball_y, fl)
            self._hud(cv)
            return cv

        self._draw_thread(cv, thread_from, ball_x, ball_y, fl, d)
        self._draw_cat(cv, pose, cx, cy, d, fl)
        self._draw_ball(cv, ball_x, ball_y, fl)
        if words:
            if words == "*bap*":
                cv.text(int(ball_x) - 2 + d * 6, fl - 4 + int(ball_y), words, C_TEXT)
            else:
                cv.text(int(cx + d * (len(pose[0]) / 2 - 4)) - 2, fl - len(pose) - 2 + int(cy), words, C_TEXT)
        if heart and t - self.last_heart > 0.5:
            self.last_heart = t
            self.hearts.append([cx + d * 17 + random.uniform(-2, 2), fl - 4, t])
        self.hearts = [h for h in self.hearts if t - h[2] < 2.2]
        for hx, hy, ht in self.hearts:
            age = t - ht
            cv.put(hx + math.sin(age * 4) * 1.2, hy - age * 3.2, "♥", C_HEART)
        self._hud(cv)
        return cv

    def _hud(self, cv):
        msg = "press any key to stop petting"
        cv.text(self.w - len(msg) - 2, self.h - 1, msg, C_HINT)

    def _draw_cat(self, cv, pose, cx, cy, d, fl):
        spr = pose if d == 1 else mirror(pose)
        w = len(spr[0])
        cv.blit(spr, cx - w / 2, fl - len(spr) + cy, cat_color)

    def _draw_ball(self, cv, bx, by, fl):
        i = int(round(bx))
        top = YARN_TOP[i % len(YARN_TOP)]
        mid = YARN_MID[i % len(YARN_MID)]
        bot = YARN_BOT[i % len(YARN_BOT)]
        x0 = bx - 4
        y0 = fl - 3 + by
        cv.blit([top, mid, bot], x0, y0,
                lambda c: C_YARN if c in "()|-" else C_YARN2)

    def _draw_thread(self, cv, x_from, bx, by, fl, d):
        a, b = sorted((int(round(x_from)), int(round(bx))))
        y = fl - 1
        tail = int(round(x_from)) + d * 9
        a, b = min(a, tail), max(b, tail)
        for x in range(a, b + 1):
            cv.put(x, y, "~" if (x // 2) % 2 else "-", C_THREAD)


def run(duration=None):
    fd = sys.stdin.fileno()
    is_tty = os.isatty(fd)
    old = termios.tcgetattr(fd) if is_tty else None
    out = sys.stdout
    try:
        if is_tty:
            tty.setcbreak(fd)
        out.write("\x1b[?1049h\x1b[?25l\x1b[2J")
        out.flush()
        size = shutil.get_terminal_size()
        scene = Scene(size.columns, size.lines)
        t0 = time.time()
        while True:
            now = time.time()
            t = now - t0
            size = shutil.get_terminal_size()
            if (size.columns, size.lines) != (scene.w, scene.h):
                scene.resize(size.columns, size.lines)
                out.write("\x1b[2J")
            out.write(scene.draw(t).render())
            out.flush()
            if duration and t > duration:
                break
            if is_tty:
                r, _, _ = select.select([fd], [], [], 1 / 24)
                if r:
                    os.read(fd, 64)
                    break
            else:
                time.sleep(1 / 24)
    except KeyboardInterrupt:
        pass
    finally:
        out.write(RESET + "\x1b[?25h\x1b[?1049l")
        out.flush()
        if old:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
    print("\x1b[38;5;214m  =^..^=  \x1b[38;5;211mmeow.\x1b[0m")


def dump(w, h, times):
    scene = Scene(w, h)
    for t in times:
        cv = scene.draw(t)
        print(f"--- t={t:.2f} {scene.state(t)[3]}")
        print("\n".join("".join(r).rstrip() for r in cv.ch))


if __name__ == "__main__":
    args = sys.argv[1:]
    if args and args[0] == "--dump":
        dump(int(args[1]), int(args[2]), [float(x) for x in args[3:]])
    else:
        dur = None
        if args and args[0] in ("-t", "--time") and len(args) > 1:
            dur = float(args[1])
        run(dur)
