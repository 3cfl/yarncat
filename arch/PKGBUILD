pkgname=yarncat
pkgver=1.2.0
pkgrel=1
pkgdesc="a little cat that rolls around in your terminal"
arch=('any')
url="https://github.com/3cfl/yarncat"
license=('MIT')
depends=('python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5ff2ae02079f92e677d86516d71c7c7534f0d38351f02abd5604c709fee091ae')

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 yarncat "$pkgdir/usr/bin/yarncat"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
